# Teller API Configuration
# Get these from https://teller.io/dashboard
TELLER_ENVIRONMENT=development
TELLER_API_KEY=your_teller_api_key_here
TELLER_APP_ID=your_app_id_here
TELLER_CERT_PATH=path/to/certificate.pem
TELLER_KEY_PATH=path/to/private_key.pem

#SnapTrade API configs
SNAPTRADE_CLIENT_ID=your_snaptrade_client_id
SNAPTRADE_CONSUMER_KEY=you_snaptrade_consumer_key

# Google Sheets Configuration
# Get Sheet ID from your Google Sheet URL: https://docs.google.com/spreadsheets/d/[SHEET_ID]/edit
SPREADSHEET_ID=your_google_sheet_id_here
SHEET_NAME=Sheet1

# Person Names - CUSTOMIZE THESE!
# These names will appear in your Google Sheet headers
# Example: "Alice Owes" and "Bob Owes"
PERSON_1_NAME=Person 1
PERSON_2_NAME=Person 2

# CSV Watch Folder (if running run_csv_watcher.sh script add variable there instead of .env file)
CSV_WATCH_FOLDER=../csv_imports

# Backend API URL (for CSV watcher)
BACKEND_URL=http://localhost:8000

# Ollama (local LLM — see docs/getting-started/ollama.md)
# Docker uses host.docker.internal; bare-metal uses http://localhost:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
OLLAMA_CHAT_MODEL=qwen2.5:14b-instruct

# Fin agent harness — opt-in tool-use loop for the advisor.
# When false, advisor uses single-shot RAG. When true, advisor calls tools
# (search_transactions, get_balance, get_debt, get_budget_status,
# get_goal_status, project_cashflow) inside a bounded loop.
# Requires Qwen 2.5 14B+ or comparable for reliable local tool-calling.
# See docs/concepts/advisor.md#agent-harness-mode-opt-in.
ADVISOR_AGENT_MODE=false
ADVISOR_AGENT_MAX_ITERS=6